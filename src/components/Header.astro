---
import { withBase } from "../lib/paths";

type Link = { name: string; url: string };

interface Props {
  title: string;
  subtitle: string[];
  authors: string[];
  affiliation: string;
  links: Link[];
}

const { title, subtitle, authors, affiliation, links } = Astro.props;
---

<header class="paper-header">
  <h1>
    <span class="paper-title">{title}</span>
    <span class="paper-subtitle">
      {subtitle.map((line) => <span>{line}</span>)}
    </span>
  </h1>
  <div class="author-block">
    <p class="authors">
      {authors.map((author) => <span>{author}</span>)}
    </p>
    <p class="affiliation">{affiliation}</p>
  </div>
  <nav class="paper-actions" aria-label="Paper resources">
    {
      links.map((link) => (
        <a class="action-link" href={link.url.startsWith("#") ? link.url : withBase(link.url)}>
          {link.name}
        </a>
      ))
    }
  </nav>
</header>
